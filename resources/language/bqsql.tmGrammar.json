{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "T-SQL",
  "scopeName": "source.bqsql",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#variables" },
    { "include": "#temp-tables" },
    { "include": "#bracket-identifiers" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-dash.sql", "match": "--.*$" },
        { "name": "comment.block.sql", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.sql",
          "begin": "N?'",
          "end": "'(?!')",
          "patterns": [ { "name": "constant.character.escape.sql", "match": "''" } ]
        }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "variable.other.global.sql", "match": "@@\\w+" },
        { "name": "variable.other.sql", "match": "@\\w+" }
      ]
    },
    "temp-tables": {
      "patterns": [ { "name": "entity.name.tag.temp-table.sql", "match": "##?\\w+" } ]
    },
    "bracket-identifiers": {
      "patterns": [
        { "name": "entity.name.type.identifier.sql", "match": "\\[(?:[^\\]]|\\]\\])*\\]" },
        { "name": "entity.name.type.identifier.sql", "match": "\"[^\"]*\"" }
      ]
    },
    "numbers": {
      "patterns": [ { "name": "constant.numeric.sql", "match": "\\b(?:0x[0-9A-Fa-f]+|\\d+\\.?\\d*(?:[eE][+-]?\\d+)?|\\.\\d+)\\b" } ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.sql",
          "match": "(?i)\\b(bigint|int|smallint|tinyint|bit|decimal|numeric|money|smallmoney|float|real|date|datetime|datetime2|datetimeoffset|smalldatetime|time|char|varchar|nchar|nvarchar|text|ntext|binary|varbinary|image|uniqueidentifier|xml|json|sql_variant|hierarchyid|geography|geometry|table|cursor|rowversion|timestamp)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.aggregate.sql",
          "match": "(?i)\\b(AVG|COUNT|COUNT_BIG|MAX|MIN|SUM|STRING_AGG|STDEV|STDEVP|VAR|VARP|APPROX_COUNT_DISTINCT|APPROX_PERCENTILE_CONT|APPROX_PERCENTILE_DISC|CHECKSUM_AGG|GROUPING|GROUPING_ID)(?=\\s*\\()"
        },
        {
          "name": "support.function.window.sql",
          "match": "(?i)\\b(ROW_NUMBER|RANK|DENSE_RANK|NTILE|LAG|LEAD|FIRST_VALUE|LAST_VALUE|PERCENT_RANK|CUME_DIST|PERCENTILE_CONT|PERCENTILE_DISC)(?=\\s*\\()"
        },
        {
          "name": "support.function.scalar.sql",
          "match": "(?i)\\b(CAST|CONVERT|TRY_CAST|TRY_CONVERT|PARSE|TRY_PARSE|COALESCE|NULLIF|ISNULL|IIF|CHOOSE|GREATEST|LEAST|ABS|CEILING|FLOOR|ROUND|POWER|SQRT|SQUARE|EXP|LOG|LOG10|SIGN|RAND|PI|CHECKSUM|BINARY_CHECKSUM|HASHBYTES|NEWID|NEWSEQUENTIALID|LEN|DATALENGTH|LEFT|RIGHT|SUBSTRING|CHARINDEX|PATINDEX|REPLACE|REPLICATE|REVERSE|STUFF|TRIM|LTRIM|RTRIM|UPPER|LOWER|CONCAT|CONCAT_WS|FORMAT|STR|SPACE|QUOTENAME|ASCII|CHAR|UNICODE|NCHAR|TRANSLATE|STRING_SPLIT|STRING_ESCAPE|GETDATE|GETUTCDATE|SYSDATETIME|SYSUTCDATETIME|SYSDATETIMEOFFSET|CURRENT_TIMESTAMP|DATEADD|DATEDIFF|DATEDIFF_BIG|DATEPART|DATENAME|DAY|MONTH|YEAR|EOMONTH|DATEFROMPARTS|DATETIMEFROMPARTS|DATETIME2FROMPARTS|TIMEFROMPARTS|DATETRUNC|SWITCHOFFSET|TODATETIMEOFFSET|ISDATE|ISNUMERIC|ISJSON|JSON_VALUE|JSON_QUERY|JSON_MODIFY|JSON_OBJECT|JSON_ARRAY|JSON_PATH_EXISTS|OPENJSON|OBJECT_ID|OBJECT_NAME|OBJECT_DEFINITION|OBJECT_SCHEMA_NAME|SCHEMA_NAME|DB_NAME|DB_ID|SUSER_SNAME|USER_NAME|CURRENT_USER|SESSION_USER|SYSTEM_USER|ORIGINAL_LOGIN|SCOPE_IDENTITY|IDENT_CURRENT|IDENTITY|ERROR_MESSAGE|ERROR_NUMBER|ERROR_LINE|ERROR_PROCEDURE|ERROR_SEVERITY|ERROR_STATE|XACT_STATE|COMPRESS|DECOMPRESS|COL_LENGTH|COL_NAME|COLUMNPROPERTY|OBJECTPROPERTY|SERVERPROPERTY|DATABASEPROPERTYEX|ATN2|ATAN|ASIN|ACOS|COS|SIN|TAN|COT|DEGREES|RADIANS|SOUNDEX|DIFFERENCE|CURSOR_STATUS|PREDICT|OPENROWSET|OPENQUERY|GENERATE_SERIES|DATE_BUCKET|LEAST|GREATEST|BIT_COUNT|LEFT_SHIFT|RIGHT_SHIFT|GET_BIT|SET_BIT)(?=\\s*\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.DML.sql",
          "match": "(?i)\\b(SELECT|INSERT|UPDATE|DELETE|MERGE|TRUNCATE|INTO|VALUES|SET|OUTPUT|FROM|WHERE|GROUP\\s+BY|HAVING|ORDER\\s+BY|TOP|DISTINCT|ALL|PERCENT|WITH\\s+TIES|OFFSET|FETCH|NEXT|FIRST|ROWS?\\s+ONLY|UNION|INTERSECT|EXCEPT|AS|ON|USING|WHEN|MATCHED|THEN|BY\\s+TARGET|BY\\s+SOURCE)\\b"
        },
        {
          "name": "keyword.other.join.sql",
          "match": "(?i)\\b((?:INNER|LEFT|RIGHT|FULL)(?:\\s+OUTER)?\\s+JOIN|CROSS\\s+JOIN|JOIN|CROSS\\s+APPLY|OUTER\\s+APPLY|PIVOT|UNPIVOT|TABLESAMPLE)\\b"
        },
        {
          "name": "keyword.other.DDL.sql",
          "match": "(?i)\\b(CREATE|ALTER|DROP|TABLE|VIEW|INDEX|SCHEMA|DATABASE|PROCEDURE|PROC|FUNCTION|TRIGGER|SEQUENCE|SYNONYM|TYPE|CONSTRAINT|PRIMARY\\s+KEY|FOREIGN\\s+KEY|REFERENCES|UNIQUE|CHECK|DEFAULT|IDENTITY|CLUSTERED|NONCLUSTERED|COLUMNSTORE|INCLUDE|ADD|COLUMN|RENAME|PARTITION|EXTERNAL|COPY|FILE_FORMAT|CREDENTIAL|LOCATION)\\b"
        },
        {
          "name": "keyword.control.flow.sql",
          "match": "(?i)\\b(BEGIN|END|IF|ELSE|WHILE|BREAK|CONTINUE|RETURN|RETURNS|GOTO|WAITFOR|TRY|CATCH|THROW|RAISERROR|PRINT|EXEC|EXECUTE|DECLARE|GO|USE|CASE|TRANSACTION|TRAN|COMMIT|ROLLBACK|SAVE|GRANT|REVOKE|DENY|OPTION|NOLOCK|HOLDLOCK|READPAST|RECOMPILE|MAXDOP)\\b"
        },
        {
          "name": "keyword.other.clause.sql",
          "match": "(?i)\\b(WITH|OVER|PARTITION|ROWS|RANGE|BETWEEN|UNBOUNDED|PRECEDING|FOLLOWING|CURRENT\\s+ROW|ASC|DESC|NULLS\\s+FIRST|NULLS\\s+LAST|COLLATE|FOR\\s+JSON|FOR\\s+XML|PATH|AUTO|ROOT|WITHOUT_ARRAY_WRAPPER|INCLUDE_NULL_VALUES)\\b"
        },
        {
          "name": "keyword.operator.logical.sql",
          "match": "(?i)\\b(AND|OR|NOT|IN|IS|NULL|LIKE|EXISTS|ANY|SOME|ESCAPE)\\b"
        },
        { "name": "constant.language.sql", "match": "(?i)\\b(TRUE|FALSE)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.sql", "match": "<=|>=|<>|!=|!<|!>|=|<|>" },
        { "name": "keyword.operator.arithmetic.sql", "match": "\\+=|-=|\\*=|/=|%=|[+\\-*/%]" },
        { "name": "keyword.operator.bitwise.sql", "match": "[&|^~]" }
      ]
    }
  }
}
