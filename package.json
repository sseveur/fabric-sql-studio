{
	"name": "fabric-sql-studio",
	"displayName": "Fabric SQL Studio",
	"description": "Microsoft Fabric Warehouse / Lakehouse and SQL Server in VS Code: browse workspaces and catalogs, run T-SQL over TDS with Entra sign-in, results grid with charts and exports, notebooks, formatter, intellisense, estimated plans, query history and data lineage.",
	"version": "3.0.0",
	"publisher": "s-seveur",
	"icon": "logo.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/sseveur/fabric-sql-studio.git"
	},
	"homepage": "https://github.com/sseveur/fabric-sql-studio",
	"bugs": {
		"url": "https://github.com/sseveur/fabric-sql-studio/issues"
	},
	"engines": {
		"vscode": "^1.82.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onView:fabric-sql-main-activity-bar",
		"onWebviewPanel:fabric-sql-query-results",
		"onWebviewPanel:fabric-sql-table-results",
		"onLanguage:sql",
		"onLanguage:fsql"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"configuration": [
			{
				"title": "Fabric SQL Studio",
				"properties": {
					"fabricSql.associateSqlFiles": {
						"type": "boolean",
						"default": false,
						"scope": "machine-overridable",
						"order": 1,
						"title": "Associate .sql files",
						"description": "When enabled, .sql files are automatically treated as T-SQL with all extension features"
					},
					"fabricSql.autoRevealResults": {
						"type": "boolean",
						"default": true,
						"scope": "machine-overridable",
						"order": 2,
						"title": "Auto-Reveal Results Panel",
						"description": "Automatically reveal the results panel when switching to a T-SQL file that has results. Disable to prevent focus switching."
					},
					"fabricSql.authMode": {
						"type": "string",
						"enum": [
							"entra-interactive",
							"azure-cli"
						],
						"enumDescriptions": [
							"Sign in with a Microsoft account through the VS Code Accounts menu.",
							"Reuse the token from an existing az login session (Azure CLI must be installed)."
						],
						"default": "entra-interactive",
						"scope": "machine-overridable",
						"order": 3,
						"title": "Authentication Mode",
						"description": "How Entra ID tokens are obtained for SQL Server / Fabric."
					},
					"fabricSql.tenantId": {
						"type": "string",
						"default": "",
						"scope": "machine-overridable",
						"order": 4,
						"title": "Entra Tenant ID",
						"description": "Tenant (directory) ID to sign in to. Leave empty for your home tenant."
					},
					"fabricSql.connections": {
						"type": "array",
						"scope": "machine-overridable",
						"order": 5,
						"title": "Connections",
						"description": "SQL endpoints to browse and query: Fabric Warehouse / Lakehouse SQL endpoints, Azure SQL, SQL Server. Entra authentication only.",
						"items": {
							"type": "object",
							"required": [
								"server"
							],
							"properties": {
								"id": {
									"type": "string",
									"description": "Display name. Defaults to server/database."
								},
								"server": {
									"type": "string",
									"description": "Host, e.g. xxxx.datawarehouse.fabric.microsoft.com or myserver.database.windows.net"
								},
								"database": {
									"type": "string",
									"description": "Database / warehouse / lakehouse to connect to. Required on Fabric."
								},
								"port": {
									"type": "number",
									"default": 1433
								}
							}
						},
						"default": []
					},
					"fabricSql.activeConnection": {
						"type": "string",
						"default": "",
						"scope": "machine-overridable",
						"order": 6,
						"title": "Active Connection",
						"description": "The connection id Ctrl+Enter queries run against. Empty = first connection."
					},
					"fabricSql.maxRows": {
						"type": "number",
						"default": 100000,
						"minimum": 1000,
						"scope": "machine-overridable",
						"order": 6,
						"title": "Max Rows",
						"description": "Rows kept per result set for paging in the grid. Larger results are cut off and flagged."
					},
					"fabricSql.defaultLocation": {
						"type": "string",
						"default": "",
						"scope": "machine-overridable",
						"order": 4,
						"title": "Default Query Location",
						"description": "Fabric SQL processing location for query jobs (e.g. US, EU, australia-southeast1, asia-east1). When empty, auto-detects from the first FROM clause via datasets.get. Set explicitly to override detection or for unqualified/CTE-only queries."
					},
					"fabricSql.costPerTB": {
						"type": "number",
						"default": 6.25,
						"minimum": 0,
						"maximum": 100,
						"scope": "machine-overridable",
						"order": 5,
						"title": "Cost per TB ($)",
						"description": "Fabric SQL cost per terabyte for query cost estimation. Default is $6.25 (on-demand pricing). Set to 0 to hide cost estimates."
					},
					"fabricSql.autoPreviewCreatedTables": {
						"type": "boolean",
						"default": false,
						"scope": "machine-overridable",
						"order": 6,
						"title": "Auto-Preview Created Tables",
						"description": "Automatically preview first 100 rows when CREATE TABLE completes successfully (disabled by default)"
					}
				}
			},
			{
				"title": "Fabric SQL Studio › Explorer",
				"properties": {
					"fabricSql.pinned-objects": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"scope": "machine-overridable",
						"title": "Pinned Objects",
						"description": "Tables / views pinned in the explorer. Format: <connection id>/database.schema.name"
					}
				}
			},
			{
				"title": "Fabric SQL Studio › Results & Clipboard",
				"properties": {
					"fabricSql.clipboardSizeLimitKb": {
						"type": "number",
						"default": 1024,
						"minimum": 1,
						"maximum": 102400,
						"scope": "machine-overridable",
						"order": 1,
						"title": "Clipboard Copy Size Limit (KB)",
						"description": "Maximum size of data (in KB) to copy to clipboard. When exceeded, you will be prompted to truncate or cancel."
					},
					"fabricSql.copyTablePathBackticks": {
						"type": "boolean",
						"default": true,
						"scope": "machine-overridable",
						"order": 2,
						"title": "Copy Table Path: Wrap in Backticks",
						"description": "When copying a table path (right-click → Copy Table Path), wrap it in backticks so it's ready to paste directly into a Fabric SQL FROM clause."
					},
					"fabricSql.gridColors": {
						"type": "object",
						"scope": "machine-overridable",
						"order": 3,
						"title": "Grid: Cell Color Scheme",
						"description": "Override cell text colors per Fabric SQL type. Leave empty to inherit from the active VS Code theme. Supports any CSS color (hex, rgb, hsl, named).",
						"properties": {
							"number": {
								"type": "string",
								"description": "INT64, FLOAT, NUMERIC, BIGNUMERIC. Default: var(--vscode-charts-blue, #4fc1ff)"
							},
							"boolean": {
								"type": "string",
								"description": "BOOL. Default: var(--vscode-charts-purple, #c586c0)"
							},
							"timestamp": {
								"type": "string",
								"description": "TIMESTAMP, DATE, DATETIME, TIME. Default: var(--vscode-charts-orange, #ce9178)"
							},
							"struct": {
								"type": "string",
								"description": "STRUCT, RECORD, JSON. Default: blended teal"
							},
							"bytes": {
								"type": "string",
								"description": "BYTES, GEOGRAPHY. Default: blended yellow"
							},
							"string": {
								"type": "string",
								"description": "STRING. Default: neutral (inherits foreground)"
							},
							"null": {
								"type": "string",
								"description": "NULL cells. Default: var(--vscode-inputValidation-warningBorder, #c5a300)"
							}
						},
						"default": {}
					}
				}
			},
			{
				"title": "Fabric SQL Studio › CTE Preview",
				"properties": {
					"fabricSql.enableCtePreviewCodeLens": {
						"type": "boolean",
						"default": true,
						"scope": "machine-overridable",
						"order": 1,
						"title": "Enable CTE Preview CodeLens",
						"description": "Show a clickable 'Preview CTE' link above each CTE in a WITH clause. Clicking runs that CTE (with its upstream dependencies) and shows the rows."
					},
					"fabricSql.ctePreviewRowLimit": {
						"type": "number",
						"default": 100,
						"minimum": 1,
						"maximum": 100000,
						"scope": "machine-overridable",
						"order": 2,
						"title": "CTE Preview Row Limit",
						"description": "Number of rows to fetch when previewing a CTE via the CodeLens (LIMIT appended to the rewritten query)."
					}
				}
			},
			{
				"title": "Fabric SQL Studio › Formatting",
				"properties": {
					"fabricSql.formatIndentStyle": {
						"type": "string",
						"default": "standard",
						"enum": [
							"standard",
							"tabularLeft",
							"tabularRight"
						],
						"scope": "machine-overridable",
						"order": 1,
						"title": "Format: Indent Style",
						"description": "SQL indent style. standard = normal indentation, tabularLeft/Right = aligned keywords"
					},
					"fabricSql.formatLeadingCommas": {
						"type": "boolean",
						"default": true,
						"scope": "machine-overridable",
						"order": 2,
						"title": "Format: Leading Commas",
						"description": "Use leading comma style (comma at start of line) instead of trailing commas"
					},
					"fabricSql.formatExpressionWidth": {
						"type": "number",
						"default": 50,
						"minimum": 1,
						"maximum": 200,
						"scope": "machine-overridable",
						"order": 3,
						"title": "Format: Expression Width",
						"description": "Maximum width of expressions before breaking into multiple lines. Lower values = more line breaks."
					},
					"fabricSql.formatInlineKeyClauses": {
						"type": "boolean",
						"default": false,
						"scope": "machine-overridable",
						"order": 4,
						"title": "Format: Inline GROUP BY / ORDER BY",
						"description": "Keep GROUP BY and ORDER BY item lists on a single line when they fit within 'Format: Expression Width', wrapping at commas only when they exceed it. SELECT is left expanded. Off by default."
					},
					"fabricSql.formatNewlineBeforeSemicolon": {
						"type": "boolean",
						"default": false,
						"scope": "machine-overridable",
						"order": 5,
						"title": "Format: Newline Before Semicolon",
						"description": "Place semicolon on a separate line at the end of statements"
					},
					"fabricSql.formatDenseOperators": {
						"type": "boolean",
						"default": false,
						"scope": "machine-overridable",
						"order": 6,
						"title": "Format: Dense Operators",
						"description": "Pack operators without surrounding spaces (e.g., 1+1 instead of 1 + 1)"
					},
					"fabricSql.formatLogicalOperatorNewline": {
						"type": "string",
						"default": "before",
						"enum": [
							"before",
							"after"
						],
						"scope": "machine-overridable",
						"order": 7,
						"title": "Format: Logical Operator Newline",
						"description": "Where to place newlines for AND/OR operators"
					},
					"fabricSql.formatLogicalOperatorStyle": {
						"type": "string",
						"default": "indented",
						"enum": [
							"keywordAligned",
							"contentAligned",
							"indented"
						],
						"scope": "machine-overridable",
						"order": 8,
						"title": "Format: Logical Operator Style",
						"description": "How AND/OR/ON are positioned relative to their parent clause. 'keywordAligned' treats them as alignment keywords, 'contentAligned' aligns them with the clause content, 'indented' (default) indents AND/OR/ON one level under the parent keyword."
					},
					"fabricSql.formatKeywordCase": {
						"type": "string",
						"default": "upper",
						"enum": [
							"upper",
							"lower",
							"preserve"
						],
						"scope": "machine-overridable",
						"order": 9,
						"title": "Format: Keyword Case",
						"description": "How to format SQL keywords (SELECT, FROM, etc.)"
					},
					"fabricSql.formatFunctionCase": {
						"type": "string",
						"default": "preserve",
						"enum": [
							"upper",
							"lower",
							"preserve"
						],
						"scope": "machine-overridable",
						"order": 10,
						"title": "Format: Function Case",
						"description": "How to format function names (COUNT, SUM, etc.)"
					},
					"fabricSql.formatIdentifierCase": {
						"type": "string",
						"default": "preserve",
						"enum": [
							"upper",
							"lower",
							"preserve"
						],
						"scope": "machine-overridable",
						"order": 11,
						"title": "Format: Identifier Case",
						"description": "How to format identifiers (table names, column names)"
					},
					"fabricSql.formatDataTypeCase": {
						"type": "string",
						"default": "preserve",
						"enum": [
							"upper",
							"lower",
							"preserve"
						],
						"scope": "machine-overridable",
						"order": 12,
						"title": "Format: Data Type Case",
						"description": "How to format data types (INT64, STRING, etc.)"
					},
					"fabricSql.completionKeywordCase": {
						"type": "string",
						"default": "upper",
						"enum": [
							"upper",
							"lower",
							"preserve"
						],
						"scope": "machine-overridable",
						"order": 13,
						"title": "Completion: Keyword Case",
						"description": "Case used when inserting SQL keyword completions (SELECT, FROM, WHERE, etc.)"
					},
					"fabricSql.completionFunctionCase": {
						"type": "string",
						"default": "preserve",
						"enum": [
							"upper",
							"lower",
							"preserve"
						],
						"scope": "machine-overridable",
						"order": 14,
						"title": "Completion: Function Case",
						"description": "Case used when inserting function name completions (COUNT, SUM, etc.). 'preserve' keeps Fabric SQL's uppercase convention."
					}
				}
			},
			{
				"title": "Fabric SQL Studio › Lineage",
				"properties": {
					"fabricSql.lineageExportTheme": {
						"type": "string",
						"default": "dark",
						"enum": [
							"dark",
							"light"
						],
						"enumDescriptions": [
							"Dark background with light text (default)",
							"White background with dark text (better for printing)"
						],
						"scope": "machine-overridable",
						"order": 1,
						"title": "Lineage Export Theme",
						"description": "Theme to use when exporting lineage charts as PNG or PDF. Light theme uses white background with dark text, which may improve text visibility and is better for printing."
					}
				}
			}
		],
		"languages": [
			{
				"id": "fsql",
				"aliases": [
					"T-SQL (Fabric / SQL Server)",
					"fsql"
				],
				"configuration": "./resources/language/fsql-language-configuration.json",
				"extensions": [
					"fsql",
					"sql"
				],
				"icon": {
					"light": "./resources/fabric-sql.svg",
					"dark": "./resources/fabric-sql.svg"
				}
			}
		],
		"grammars": [
			{
				"language": "fsql",
				"scopeName": "source.fsql",
				"path": "./resources/language/fsql.tmGrammar.json"
			},
			{
				"scopeName": "source.sql.fsql-injection",
				"path": "./resources/language/fsql.tmGrammar.json",
				"injectTo": [
					"source.sql"
				]
			}
		],
		"snippets": [
			{
				"language": "fsql",
				"path": "./resources/language/snippets.json"
			}
		],
		"configurationDefaults": {
			"[fsql]": {
				"editor.semanticHighlighting.enabled": true
			},
			"[sql]": {
				"editor.semanticHighlighting.enabled": true
			}
		},
		"commands": [
			{
				"command": "fabricSql.run-query",
				"title": "Fabric SQL: Run Query",
				"icon": "$(debug-start)"
			},
			{
				"command": "fabricSql.run-selected-query",
				"title": "Fabric SQL: Run Selected Query",
				"icon": "$(debug-line-by-line)"
			},
			{
				"command": "fabricSql.profile-column",
				"title": "Fabric SQL: Profile Column",
				"icon": "$(graph)"
			},
			{
				"command": "fabricSql.preview-table-at-cursor",
				"title": "Fabric SQL: Preview Table",
				"icon": "$(table)"
			},
			{
				"command": "fabricSql.user-login",
				"title": "Fabric SQL: Sign In"
			},
			{
				"command": "fabricSql.auth-token-info",
				"title": "Fabric SQL: Show Auth Token Info"
			},
			{
				"command": "fabricSql.authentication-refresh",
				"title": "Fabric SQL: Refresh Authentication",
				"icon": "$(refresh)"
			},
			{
				"command": "fabricSql.explorer-refresh",
				"title": "Fabric SQL: Refresh Explorer",
				"icon": "$(refresh)"
			},
			{
				"command": "fabricSql.view-table",
				"title": "Fabric SQL: Preview (Top 100)",
				"icon": "$(link-external)"
			},
			{
				"command": "fabricSql.view-table-schema",
				"title": "Fabric SQL: Preview Schema",
				"icon": "$(symbol-class)"
			},
			{
				"command": "fabricSql.create-table-default-query",
				"title": "Fabric SQL: Create Query",
				"icon": "$(file-text)"
			},
			{
				"command": "fabricSql.open-ddl",
				"title": "Fabric SQL: Open Definition",
				"icon": "$(link-external)"
			},
			{
				"command": "fabricSql.set-default-project",
				"title": "Fabric SQL: Use This Connection",
				"icon": "$(issue-closed)"
			},
			{
				"command": "fabricSql.download-csv",
				"title": "Fabric SQL: Download CSV",
				"icon": "$(cloud-download)"
			},
			{
				"command": "fabricSql.download-jsonl",
				"title": "Fabric SQL: Download JSONL",
				"icon": "$(json)"
			},
			{
				"command": "fabricSql.copy-to-clipboard",
				"title": "Fabric SQL: Copy to Clipboard",
				"icon": "$(clippy)"
			},
			{
				"command": "fabricSql.open-settings-connections",
				"title": "Fabric SQL: Open Settings - Connections"
			},
			{
				"command": "fabricSql.add-fabric-connection",
				"title": "Fabric SQL: Add Fabric Connection",
				"icon": "$(add)"
			},
			{
				"command": "fabricSql.format-query",
				"title": "Fabric SQL: Format SQL",
				"icon": "$(symbol-structure)"
			},
			{
				"command": "fabricSql.history-rerun",
				"title": "Fabric SQL: Re-run Query",
				"icon": "$(debug-start)"
			},
			{
				"command": "fabricSql.history-copy",
				"title": "Fabric SQL: Copy Query",
				"icon": "$(copy)"
			},
			{
				"command": "fabricSql.history-show",
				"title": "Fabric SQL: Show Query"
			},
			{
				"command": "fabricSql.history-delete",
				"title": "Fabric SQL: Delete from History",
				"icon": "$(trash)"
			},
			{
				"command": "fabricSql.history-clear",
				"title": "Fabric SQL: Clear All History",
				"icon": "$(clear-all)"
			},
			{
				"command": "fabricSql.history-refresh",
				"title": "Fabric SQL: Refresh History",
				"icon": "$(refresh)"
			},
			{
				"command": "fabricSql.job-history-refresh",
				"title": "Fabric SQL: Refresh Job History",
				"icon": "$(refresh)"
			},
			{
				"command": "fabricSql.job-history-toggle-all-users",
				"title": "Fabric SQL: Job History — Toggle All Users",
				"icon": "$(organization)"
			},
			{
				"command": "fabricSql.explain-query",
				"title": "Fabric SQL: Show Estimated Plan",
				"icon": "$(graph)"
			},
			{
				"command": "fabricSql.explain-query-xml",
				"title": "Fabric SQL: Show Estimated Plan XML"
			},
			{
				"command": "fabricSql.job-history-details",
				"title": "Fabric SQL: Job Details",
				"icon": "$(info)"
			},
			{
				"command": "fabricSql.show-lineage",
				"title": "Fabric SQL: Show Data Lineage",
				"icon": "$(type-hierarchy)"
			},
			{
				"command": "fabricSql.show-lineage-selection",
				"title": "Fabric SQL: Show Data Lineage for Selection",
				"icon": "$(type-hierarchy)"
			},
			{
				"command": "fabricSql.refresh-schema-cache",
				"title": "Fabric SQL: Refresh Schema Cache",
				"icon": "$(refresh)"
			},
			{
				"command": "fabricSql.set-lineage-export-theme",
				"title": "Fabric SQL: Toggle Lineage Export Theme",
				"icon": "$(arrow-swap)"
			},
			{
				"command": "fabricSql.revoke-session",
				"title": "Fabric SQL: Sign Out",
				"icon": "$(sign-out)"
			},
			{
				"command": "fabricSql.pin-table",
				"title": "Fabric SQL: Pin Table",
				"icon": "$(pin)"
			},
			{
				"command": "fabricSql.unpin-table",
				"title": "Fabric SQL: Unpin Table",
				"icon": "$(pinned)"
			},
			{
				"command": "fabricSql.search-tables",
				"title": "Fabric SQL: Search Tables",
				"icon": "$(search)"
			},
			{
				"command": "fabricSql.clear-search",
				"title": "Fabric SQL: Clear Search",
				"icon": "$(close)"
			},
			{
				"command": "fabricSql.copy-table-path",
				"title": "Fabric SQL: Copy Table Path",
				"icon": "$(copy)"
			},
			{
				"command": "fabricSql.build-table-index",
				"title": "Fabric SQL: Build Table Index",
				"icon": "$(database)"
			},
			{
				"command": "fabricSql.clear-extension-cache",
				"title": "Fabric SQL: Clear Extension State Cache"
			},
			{
				"command": "fabricSql.open-as-notebook",
				"title": "Fabric SQL: Open as Notebook",
				"icon": "$(notebook)"
			},
			{
				"command": "fabricSql.open-as-text",
				"title": "Fabric SQL: Open as Text",
				"icon": "$(code)"
			}
		],
		"notebooks": [
			{
				"type": "fabric-sql-notebook",
				"displayName": "T-SQL Notebook",
				"selector": [
					{
						"filenamePattern": "*.fsql"
					},
					{
						"filenamePattern": "*.sql"
					}
				],
				"priority": "option"
			}
		],
		"notebookRenderer": [
			{
				"id": "fabric-sql-grid-renderer",
				"displayName": "Fabric SQL Results Grid",
				"entrypoint": "./resources/notebook-renderer.js",
				"mimeTypes": [
					"application/vnd.fabric-sql.grid+json"
				],
				"requiresMessaging": "optional"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "fabricSql.run-query",
					"group": "navigation@-3",
					"when": "editorLangId == fsql || editorLangId == sql"
				},
				{
					"command": "fabricSql.run-selected-query",
					"group": "navigation@-2",
					"when": "editorLangId == fsql || editorLangId == sql"
				},
				{
					"command": "fabricSql.show-lineage",
					"group": "navigation@-1",
					"when": "editorLangId == fsql || editorLangId == sql"
				},
				{
					"command": "fabricSql.open-as-notebook",
					"group": "navigation@100",
					"when": "editorLangId == fsql || editorLangId == sql"
				},
				{
					"command": "fabricSql.open-as-text",
					"group": "navigation@100",
					"when": "notebookType == fabric-sql-notebook"
				}
			],
			"editor/context": [
				{
					"command": "fabricSql.show-lineage-selection",
					"group": "1_modification",
					"when": "editorHasSelection && (editorLangId == fsql || editorLangId == sql)"
				},
				{
					"command": "fabricSql.profile-column",
					"group": "1_modification",
					"when": "editorLangId == fsql || editorLangId == sql"
				},
				{
					"command": "fabricSql.preview-table-at-cursor",
					"group": "1_modification",
					"when": "editorLangId == fsql || editorLangId == sql"
				},
				{
					"command": "fabricSql.explain-query",
					"group": "1_modification",
					"when": "editorLangId == fsql || editorLangId == sql"
				}
			],
			"view/title": [
				{
					"command": "fabricSql.authentication-refresh",
					"group": "navigation",
					"when": "view == 'fabric-sql-authentication'"
				},
				{
					"command": "fabricSql.add-fabric-connection",
					"group": "navigation@1",
					"when": "view == 'fabric-sql-tree-data-provider'"
				},
				{
					"command": "fabricSql.explorer-refresh",
					"group": "navigation",
					"when": "view == 'fabric-sql-tree-data-provider'"
				},
				{
					"command": "fabricSql.search-tables",
					"group": "navigation",
					"when": "view == 'fabric-sql-tree-data-provider'"
				},
				{
					"command": "fabricSql.clear-search",
					"group": "navigation",
					"when": "view == 'fabric-sql-tree-data-provider' && fabric-sql.isSearching"
				},
				{
					"command": "fabricSql.history-refresh",
					"group": "navigation",
					"when": "view == 'fabric-sql-query-history'"
				},
				{
					"command": "fabricSql.history-clear",
					"group": "navigation",
					"when": "view == 'fabric-sql-query-history'"
				},
				{
					"command": "fabricSql.job-history-refresh",
					"group": "navigation",
					"when": "view == 'fabric-sql-job-history'"
				},
				{
					"command": "fabricSql.job-history-toggle-all-users",
					"group": "navigation",
					"when": "view == 'fabric-sql-job-history'"
				}
			],
			"view/item/context": [
				{
					"command": "fabricSql.job-history-details",
					"when": "viewItem == 'fsql-job-history-job'",
					"group": "inline"
				},
				{
					"command": "fabricSql.view-table",
					"when": "viewItem == 'sql-table' || viewItem == 'sql-pinned-table' || viewItem == 'sql-table-already-pinned'"
				},
				{
					"command": "fabricSql.view-table-schema",
					"when": "viewItem == 'sql-table' || viewItem == 'sql-pinned-table' || viewItem == 'sql-table-already-pinned'"
				},
				{
					"command": "fabricSql.create-table-default-query",
					"when": "viewItem == 'sql-table' || viewItem == 'sql-pinned-table' || viewItem == 'sql-table-already-pinned'"
				},
				{
					"command": "fabricSql.open-ddl",
					"when": "viewItem == 'sql-table' || viewItem == 'sql-pinned-table' || viewItem == 'sql-table-already-pinned' || viewItem == 'sql-routine'"
				},
				{
					"command": "fabricSql.pin-table",
					"when": "viewItem == 'sql-table'",
					"group": "inline"
				},
				{
					"command": "fabricSql.unpin-table",
					"when": "viewItem == 'sql-pinned-table' || viewItem == 'sql-table-already-pinned'",
					"group": "inline"
				},
				{
					"command": "fabricSql.copy-table-path",
					"when": "viewItem == 'sql-table' || viewItem == 'sql-pinned-table' || viewItem == 'sql-table-already-pinned'"
				},
				{
					"command": "fabricSql.set-default-project",
					"when": "viewItem == 'sql-connection'",
					"group": "inline"
				},
				{
					"command": "fabricSql.history-rerun",
					"when": "viewItem == 'fsql-history-query'",
					"group": "inline"
				},
				{
					"command": "fabricSql.history-copy",
					"when": "viewItem == 'fsql-history-query'",
					"group": "inline"
				},
				{
					"command": "fabricSql.history-delete",
					"when": "viewItem == 'fsql-history-query'",
					"group": "inline"
				}
			]
		},
		"views": {
			"fabric-sql-main-activity-bar": [
				{
					"id": "fabric-sql-authentication",
					"name": "Authentication",
					"contextualTitle": "Fabric SQL",
					"type": "webview"
				},
				{
					"id": "fabric-sql-tree-data-provider",
					"name": "Explorer",
					"contextualTitle": "Fabric SQL",
					"type": "tree"
				},
				{
					"id": "fabric-sql-query-history",
					"name": "Query History",
					"contextualTitle": "Fabric SQL",
					"type": "tree"
				},
				{
					"id": "fabric-sql-job-history",
					"name": "Job History (server)",
					"contextualTitle": "Fabric SQL",
					"type": "tree",
					"visibility": "collapsed"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "fabric-sql-main-activity-bar",
					"title": "Fabric SQL",
					"icon": "./resources/fabric-sql.svg"
				}
			]
		},
		"keybindings": [
			{
				"command": "fabricSql.run-query",
				"key": "Ctrl+Enter",
				"when": "editorLangId == fsql || editorLangId == sql"
			},
			{
				"command": "fabricSql.run-selected-query",
				"key": "Ctrl+E",
				"when": "editorLangId == fsql || editorLangId == sql"
			},
			{
				"command": "fabricSql.format-query",
				"key": "Shift+Alt+F",
				"when": "editorLangId == fsql || editorLangId == sql"
			}
		],
		"viewsWelcome": [
			{
				"view": "fabric-sql-tree-data-provider",
				"contents": "No connections configured.\n\nSign in from the Authentication view, then\n[Add Fabric Connection](command:fabricSql.add-fabric-connection) to pick a workspace and warehouse / lakehouse,\nor [edit settings](command:fabricSql.open-settings-connections) to add an Azure SQL / SQL Server host."
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "webpack",
		"watch": "webpack --watch",
		"package": "webpack --mode production --devtool hidden-source-map",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js",
		"test:unit": "npm run compile-tests && mocha \"out/test/unit/**/*.test.js\" --require ./out/test/unit/_setup.js --ui tdd --timeout 10000",
		"deploy": "vsce publish",
		"package-dev": "vsce package --pre-release"
	},
	"devDependencies": {
		"@types/glob": "^7.2.0",
		"@types/jsdom": "^27.0.0",
		"@types/mocha": "^9.1.1",
		"@types/mssql": "^12.3.0",
		"@types/node": "16.x",
		"@types/vscode": "^1.63.0",
		"@typescript-eslint/eslint-plugin": "^5.30.0",
		"@typescript-eslint/parser": "^5.30.0",
		"@vscode/test-electron": "^2.1.5",
		"@vscode/vsce": "^2.18.0",
		"eslint": "^8.18.0",
		"glob": "^8.0.3",
		"mocha": "^10.0.0",
		"ts-loader": "^9.3.1",
		"typescript": "^4.7.4",
		"webpack": "^5.88.2",
		"webpack-cli": "^5.1.4"
	},
	"dependencies": {
		"@azure/identity": "^4.13.2",
		"@vscode/codicons": "^0.0.32",
		"@vscode/webview-ui-toolkit": "^1.2.2",
		"csv-writer": "^1.6.0",
		"jsdom": "^27.4.0",
		"jspdf": "^2.5.2",
		"mssql": "^12.7.0",
		"preact": "^10.28.0",
		"preact-render-to-string": "^6.6.3",
		"sql-formatter": "^15.6.10",
		"svg2pdf.js": "^2.7.0"
	}
}
